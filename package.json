{
  "name": "privacy-guard",
  "version": "0.13.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "dev:agent": "node tools/agent-browser.mjs",
    "screenshots:store": "node tools/capture-store-screenshots.mjs",
    "promos:store": "node tools/capture-store-promos.mjs",
    "assets:store": "pnpm screenshots:store && pnpm promos:store",
    "build": "wxt build",
    "build:edge": "wxt build -b edge",
    "build:firefox": "wxt build -b firefox --mv3",
    "build:all": "pnpm build && pnpm build:edge && pnpm build:firefox",
    "zip": "wxt zip",
    "zip:edge": "wxt zip -b edge",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "zip:all": "pnpm zip && pnpm zip:edge && pnpm zip:firefox",
    "compile": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && playwright test",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@preact/signals": "^2.11.2",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^26.4.1",
    "eslint": "^10.10.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11",
    "wxt": "^0.21.4"
  }
}
